<UserControl 
 xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:StoreBillingDesktop.ViewModels"
 xmlns:models="using:StoreBillingDesktop.Models"
 x:DataType="vm:MainViewModel"
 x:Class="StoreBillingDesktop.Views.ReportsView">

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <TextBlock Grid.Column="0" Text="Sales Report Dashboard" FontSize="32" FontWeight="Black" Foreground="#111827"/>
            <Button Grid.Column="1" Content="📥 Export CSV" Command="{Binding ExportSalesToCSVCommand}" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="20,12" CornerRadius="6" FontSize="16"/>
        </Grid>
        
        <Border DockPanel.Dock="Top" Background="#8B5CF6" CornerRadius="12" Padding="30" Margin="0,0,0,30" BoxShadow="0 10 20 -5 #558B5CF6">
            <StackPanel>
                <TextBlock Text="Total Revenue Generated" FontSize="18" FontWeight="SemiBold" Foreground="#DDD6FE"/>
                <TextBlock Text="{Binding TotalRevenue, StringFormat='Rs. {0:N2}'}" FontSize="48" FontWeight="Black" Foreground="White"/>
            </StackPanel>
        </Border>
        
        <TextBlock DockPanel.Dock="Top" Text="Recent Transactions" FontSize="20" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,15"/>
        
        <ListBox ItemsSource="{Binding SalesHistory}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Order">
                    <Expander HorizontalAlignment="Stretch" Margin="0,0,0,10" CornerRadius="8" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                        <Expander.Header>
                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="10,5">
                                <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='Order #{0}'}" FontSize="18" FontWeight="Black" Foreground="#4B5563" VerticalAlignment="Center" Width="120"/>
                                <TextBlock Grid.Column="1" Text="{Binding OrderDate, StringFormat='{}{0:MMM dd, yyyy - hh:mm tt}'}" FontSize="16" FontWeight="Medium" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" FontSize="20" FontWeight="Black" Foreground="#111827" VerticalAlignment="Center"/>
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <Border Background="#F9FAFB" CornerRadius="6" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,10,0,0">
                                <ItemsControl ItemsSource="{Binding OrderItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:OrderItem">
                                            <Grid ColumnDefinitions="3*, 1*, 1*" Margin="0,6">
                                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="16" FontWeight="SemiBold" Foreground="#374151" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" FontSize="16" Foreground="#6B7280" VerticalAlignment="Center"><Run Text="{Binding Quantity, StringFormat='{}{0} x '}" /><Run Text="{Binding UnitPrice, StringFormat='Rs. {0:N2}'}" /></TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='Rs. {0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Expander.Content>
                    </Expander>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>